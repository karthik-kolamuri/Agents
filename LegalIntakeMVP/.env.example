# --- Agno / LLM ---
# Get your API key from Groq console
GROQ_API_KEY=

# --- feature flags ---
# Set to 'False' to use REAL APIs (costs money/credits). 
# Set to 'True' to test without keys.
MOCK_MODE=True

# --- Google Workspace ---
# Path to your Service Account JSON key file (relative to this .env or absolute)
GOOGLE_APPLICATION_CREDENTIALS=google_credentials.json

# The ID of the Google Sheet to log leads to (found in the URL: docs.google.com/spreadsheets/d/YOUR_ID/edit)
GOOGLE_SHEET_ID=

# --- Twilio / WhatsApp ---
# Get these from your Twilio Console Dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Your Twilio Sandbox number (default is usually this one)
TWILIO_FROM_NUMBER=whatsapp:+14155238886
